def run_simulation(omega_drive):
    print(omega_drive)
    initial_state = meas_basis[0]
    t_list = np.arange(0, 300, 0.05)
    drive_len_list = np.arange(0, 141, 10)
    pop0_list = []
    for drive_len in drive_len_list: 
        start_time = time.time()  # Start timer
        args = {"omega_drive" : omega_drive, "drive_len": drive_len}
        result = qutip.mesolve(H_total, initial_state, t_list, args = args)
        final_state = result.states[-1]
        pop0 = (proj_list[0]*final_state*final_state.dag()).tr()
        pop0_list.append(pop0)
        print(f"Elapsed time: {time.time() - start_time:.6f} seconds")
    return pop0_list

if __name__ == "__main__":

    omega_drive_list = np.linspace(0.02, 0.10, 5)

    pool = Pool(processes=5, maxtasksperchild=1)  # Adjust the number of processes based on your CPU
    results = pool.map(run_simulation, omega_drive_list)
    pool.close()
    pool.join()

    power_rabi_list = results
    for power_rabi in power_rabi_list:
        plt.plot(power_rabi)
    plt.grid()
    plt.ylabel("Ground state population")
    plt.xlabel("Frequency")
    plt.show()
